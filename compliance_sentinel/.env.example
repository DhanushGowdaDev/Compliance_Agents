# =============================================================================
# Compliance Sentinel — Environment Configuration
# =============================================================================

# NVIDIA NIM API key — get from https://build.nvidia.com → top-right "Get API Key"
# Format: nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_API_KEY=nvapi-PASTE-YOUR-KEY-HERE

# NVIDIA NIM base URL — trailing slash is required for the OpenAI client
NIM_BASE_URL=https://integrate.api.nvidia.com/v1/

# Model — any NIM model slug works here
# Confirmed available: meta/llama-3.3-70b-instruct  |  meta/llama-3.1-8b-instruct
#                      mistralai/mistral-large        |  nvidia/llama-3.1-nemotron-70b-instruct
DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# Jurisdiction (informational — agents always cover GDPR + CCPA/CPRA)
JURISDICTION=US,EU
